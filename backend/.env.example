DATABASE_URL=postgresql://user:password@hostname/neondb?sslmode=require

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Chat message encryption-at-rest (app/core/crypto.py). Base64-encoded
# 32-byte key, e.g. generate one with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Optional in dev (falls back to a key derived from SECRET_KEY) but should
# always be set explicitly in production.
CHAT_MASTER_KEY=